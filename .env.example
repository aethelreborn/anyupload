# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------
# "r2"    -> Cloudflare R2 (the real thing, use this in production)
# "local" -> files on this machine's disk (.storage/), for development only
#
# Leave this unset and the app auto-detects: r2 when the credentials below
# are present, local otherwise.
STORAGE_PROVIDER=r2

# ---------------------------------------------------------------------------
# Cloudflare R2 credentials
# ---------------------------------------------------------------------------
# Cloudflare dashboard -> R2 -> Account ID
R2_ACCOUNT_ID=

# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create Account API token
#   permission: Object Read & Write
# The Access Key ID / Secret Access Key are shown once, copy them now.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The bucket that holds the files. Create it with `npm run r2:setup` or by hand
# in the R2 dashboard.
R2_BUCKET_NAME=anyupload

# ---------------------------------------------------------------------------
# Admin key
# ---------------------------------------------------------------------------
# Required to delete uploads from the receive page. The UI asks for it once
# and stores it in the browser. Leave empty to disable deleting entirely.
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Used for share links and for the local development upload endpoint.
NEXT_PUBLIC_SITE_URL=https://darkie.dpdns.org
