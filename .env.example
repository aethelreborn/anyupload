# ---------------------------------------------------------------------------
# Storage backend
# ---------------------------------------------------------------------------
# "blob"  -> Vercel Blob. No payment method needed, 1 GB free per month.
# "r2"    -> Cloudflare R2. 10 GB free, but needs a card on file.
# "local" -> files on this machine's disk (.storage/), development only
#
# Leave this unset and the app auto-detects: blob when a Blob store is
# connected, otherwise r2 when the R2 credentials are present, otherwise local.
STORAGE_PROVIDER=blob

# ---------------------------------------------------------------------------
# Vercel Blob
# ---------------------------------------------------------------------------
# Created with:
#   vercel blob create-store anyupload --access public --yes
# The CLI adds BLOB_READ_WRITE_TOKEN for you. BLOB_STORE_ID is what the
# public URL is built from: <id>.public.blob.vercel-storage.com
BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Cloudflare R2 (only needed if you switch to the r2 backend)
# ---------------------------------------------------------------------------
# Cloudflare dashboard -> R2 -> Account ID
R2_ACCOUNT_ID=
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create Account API token
#   permission: Object Read & Write
# The Access Key ID / Secret Access Key are shown once, copy them now.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket that holds the files.
R2_BUCKET_NAME=anyupload

# ---------------------------------------------------------------------------
# Admin key
# ---------------------------------------------------------------------------
# Required to delete uploads from the receive page. The UI asks for it once
# and stores it in the browser. Leave empty to disable deleting entirely.
ADMIN_KEY=

# ---------------------------------------------------------------------------
# Upload session secret
# ---------------------------------------------------------------------------
# Required to sign upload sessions. Set a strong random value in production.
UPLOAD_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Used for share links and for the local development upload endpoint.
NEXT_PUBLIC_SITE_URL=https://darkie.dpdns.org
